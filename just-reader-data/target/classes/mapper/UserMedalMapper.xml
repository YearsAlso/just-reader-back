<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yearsalso.data.mapper.UserMedalMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yearsalso.data.entity.UserMedal">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="medal_id" property="medalId"/>
        <result column="is_unlocked" property="isUnlocked"/>
        <result column="unlock_time" property="unlockTime"/>
        <result column="level" property="level"/>
        <result column="is_display" property="isDisplay"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        user_id,
        medal_id,
        is_unlocked,
        unlock_time,
        level,
        is_display,
        create_by,
        create_time,
        update_by,
        update_time,
        remark
    </sql>

</mapper>