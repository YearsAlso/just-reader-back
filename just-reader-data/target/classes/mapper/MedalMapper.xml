<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yearsalso.data.mapper.MedalMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yearsalso.data.entity.Medal">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="medal_group" property="medalGroup"/>
        <result column="level" property="level"/>
        <result column="icon" property="icon"/>
        <result column="bg_color" property="bgColor"/>
        <result column="unlock_condition" property="unlockCondition"/>
        <result column="reward_type" property="rewardType"/>
        <result column="reward_value" property="rewardValue"/>
        <result column="display_order" property="displayOrder"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        name,
        description,
        medal_group,
        level,
        icon,
        bg_color,
        unlock_condition,
        reward_type,
        reward_value,
        display_order,
        create_by,
        create_time,
        update_by,
        update_time,
        remark
    </sql>

</mapper>